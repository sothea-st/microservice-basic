spring:
  application:
    name: user-service # 👈 this MUST match your file name in config-repo (auth-service.yml)
  profiles:
    active: dev
  cloud:
    config:
      import: optional:configserver:http://localhost:8888

eureka:
  client:
    service-url:
      defaultZone: http://localhost:8761/eureka
  instance:
    prefer-ip-address: true
    hostname: localhost